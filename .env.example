# Copy to .env for local runs. These map to Secrets Manager / env vars in the cloud.
DATABASE_URL=sqlite:///./data/shipments.db
API_KEY=teaching-demo-key
DELAY_CHECK_MINUTES=5
# Optional: POST delay alerts here (maps to SNS / webhook subscribers)
NOTIFY_WEBHOOK_URL=
# Optional SMTP (maps to SES). Leave blank to log notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dispatch@shipvis.local
SMTP_TO=ops@shipvis.local
PORT=8000
